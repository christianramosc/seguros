# Copia este archivo como .streamlit/secrets.toml (local) o pega el contenido
# en Settings → Secrets de Streamlit Community Cloud.
APP_PASSWORD = "cambia-esta-clave"

# ---- Copia de las pólizas en Google Sheets (opcional), pestaña «Polizas»
# Si no pones POLIZAS_SHEET_URL se usa SEGUIMIENTO_SHEET_URL (el mismo Sheet de reportessaleu).
# Compártelo como EDITOR con client_email.
SEGUIMIENTO_SHEET_URL = "https://docs.google.com/spreadsheets/d/XXXXXXXXXXXX/edit"
# POLIZAS_SHEET_URL = "https://docs.google.com/spreadsheets/d/ZZZZZZZZZZZZ/edit"

# Contenido del JSON de la cuenta de servicio (el mismo bloque que en reportessaleu)
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "…"
private_key = "-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
client_email = "cuadres-mg@tu-proyecto.iam.gserviceaccount.com"
client_id = "…"
token_uri = "https://oauth2.googleapis.com/token"
